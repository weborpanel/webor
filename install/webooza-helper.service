[Unit]
Description=Webooza root helper
Documentation=https://github.com/webooza/webooza
After=network-online.target
Before=webooza.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/webooza-helper -socket /run/webooza/helper.sock
RuntimeDirectory=webooza
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2

# Helper must run as root; keep the attack surface small via the typed allowlist.
# Additional sandboxing is limited because the helper performs privileged ops.
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
