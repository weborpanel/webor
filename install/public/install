#!/usr/bin/env bash
# Public bootstrap installer (S3 releases). Prefer https://webor.dev/install.
# Usage (defaults to beta until a real stable v0.1.0 ships):
#   curl -fsSL https://webor.dev/install | sudo bash
# Stable (when ready) or override channel (flag after bash -s — env before curl does NOT reach sudo):
#   curl -fsSL https://webor.dev/install | sudo bash -s -- --channel stable
#   curl -fsSL …/install | sudo env WEBOR_CHANNEL=stable bash
# Optional install.sh flags after --:
#   curl -fsSL https://webor.dev/install | sudo bash -s -- --skip-ptr
set -euo pipefail

BASE_URL="${WEBOR_BASE_URL:-https://webor-releases-360386317256.s3.ap-south-1.amazonaws.com/webor}"
# Public beta: default to beta. Switch back to stable after cutting v0.1.0.
CHANNEL="${WEBOR_CHANNEL:-beta}"

# Parse bootstrap-only flags; remaining args go to install.sh.
PASS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --channel)
      [[ $# -ge 2 ]] || { echo "missing value for --channel" >&2; exit 1; }
      CHANNEL="$2"
      shift 2
      ;;
    --channel=*)
      CHANNEL="${1#--channel=}"
      shift
      ;;
    --base-url)
      [[ $# -ge 2 ]] || { echo "missing value for --base-url" >&2; exit 1; }
      BASE_URL="$2"
      shift 2
      ;;
    --base-url=*)
      BASE_URL="${1#--base-url=}"
      shift
      ;;
    *)
      PASS+=("$1")
      shift
      ;;
  esac
done

case "$CHANNEL" in
  stable|beta) ;;
  *)
    echo "unsupported channel: $CHANNEL (want stable or beta)" >&2
    exit 1
    ;;
esac

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *)
    echo "unsupported arch: $ARCH" >&2
    exit 1
    ;;
esac

if [[ "$(id -u)" -ne 0 ]]; then
  echo "re-run as root (sudo)" >&2
  exit 1
fi

need() { command -v "$1" >/dev/null 2>&1 || { echo "missing required command: $1" >&2; exit 1; }; }
need curl
need tar
need sha256sum

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

TAR="webor-linux-${ARCH}.tar.gz"
SUMS="SHA256SUMS"
URL_TAR="${BASE_URL}/downloads/${CHANNEL}/${TAR}"
URL_SUMS="${BASE_URL}/downloads/${CHANNEL}/${SUMS}"

echo "[webor] channel=${CHANNEL}"
echo "[webor] downloading ${URL_TAR}"
curl -fsSL "$URL_TAR" -o "${TMP}/${TAR}"
echo "[webor] downloading ${URL_SUMS}"
curl -fsSL "$URL_SUMS" -o "${TMP}/${SUMS}"

(
  cd "$TMP"
  # Verify only the tarball line from SHA256SUMS
  grep -E "[[:space:]]${TAR}\$" "$SUMS" | sha256sum -c -
)

echo "[webor] extracting"
tar -xzf "${TMP}/${TAR}" -C "$TMP"
ROOT="$(find "$TMP" -maxdepth 1 -type d -name 'webor-linux-*' | head -n1)"
[[ -n "$ROOT" && -x "${ROOT}/install/install.sh" ]] || {
  echo "tarball layout unexpected (missing install/install.sh)" >&2
  exit 1
}

# Ensure Caddy exists (needed for site TLS later). Best-effort on Debian/Ubuntu or EL.
if ! command -v caddy >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    echo "[webor] installing caddy via apt"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y caddy || echo "[webor] WARN: apt install caddy failed — continue; install Caddy manually then re-run"
  else
    echo "[webor] installing Caddy official binary to /usr/bin/caddy"
    ver="$(curl -fsSL https://api.github.com/repos/caddyserver/caddy/releases/latest | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -1 | sed 's/.*"v/v/;s/"$//' )"
    if [[ -z "$ver" ]]; then
      echo "[webor] WARN: could not resolve Caddy release — install Caddy manually then re-run"
    else
      ctmp="$(mktemp -d)"
      curl -fsSL "https://github.com/caddyserver/caddy/releases/download/${ver}/caddy_${ver#v}_linux_${ARCH}.tar.gz" -o "${ctmp}/caddy.tgz" \
        && tar -xzf "${ctmp}/caddy.tgz" -C "${ctmp}" \
        && install -m 0755 "${ctmp}/caddy" /usr/bin/caddy \
        || echo "[webor] WARN: Caddy binary install failed — install Caddy manually then re-run"
      rm -rf "${ctmp}"
    fi
  fi
fi

echo "[webor] running install.sh"
INSTALL_ARGS=(--yes --bin-dir "${ROOT}/bin" --channel "${CHANNEL}")
[[ -n "${BASE_URL}" && "${BASE_URL}" != "https://webor-releases-360386317256.s3.ap-south-1.amazonaws.com/webor" ]] && INSTALL_ARGS+=(--base-url "${BASE_URL}")
exec "${ROOT}/install/install.sh" "${INSTALL_ARGS[@]}" "${PASS[@]+"${PASS[@]}"}"
