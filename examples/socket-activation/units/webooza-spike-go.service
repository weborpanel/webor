[Unit]
Description=Webooza Spike B Go app (socket activated)
Requires=webooza-spike-go.socket
After=webooza-spike-go.socket

[Service]
Type=simple
ExecStart=/usr/local/lib/webooza-spike/spike-socket-go
# Scale toward idle stop in later milestones; for the spike keep Restart off.
Restart=no

# Uncomment for idle-ish demos once validated:
# StopWhenUnneeded=true

[Install]
WantedBy=multi-user.target
